{
  "name": "nbv-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cache:check": "node scripts/cloudflare/cache.mjs check",
    "cache:purge": "node scripts/cloudflare/cache.mjs purge",
    "sanity": "sanity",
    "sanity:deploy": "sanity deploy",
    "sanity:typegen": "sanity schema extract --path=./src/sanity/schema.json --force && sanity typegen generate",
    "sanity:migrate": "sanity exec scripts/sanity/migrate.ts --with-user-token --",
    "sanity:migrate:dry": "sanity exec scripts/sanity/migrate.ts -- --dry-run",
    "sanity:migrate:token": "sanity exec scripts/sanity/migrate.ts --",
    "sanity:seed-demo": "sanity exec scripts/sanity/seed-demo-page.ts --",
    "sanity:images": "node scripts/sanity/upload-images.mjs",
    "sanity:images:dry": "node scripts/sanity/upload-images.mjs --dry-run",
    "cloudflare:rules": "node scripts/cloudflare/cache-rules.mjs",
    "cloudflare:rules:dry": "node scripts/cloudflare/cache-rules.mjs --dry-run",
    "sanity:rich-text": "node scripts/sanity/migrate-rich-text.mjs",
    "sanity:rich-text:dry": "node scripts/sanity/migrate-rich-text.mjs --dry-run",
    "sanity:fix-pages": "node scripts/sanity/fix-seeded-pages.mjs",
    "sanity:fix-pages:dry": "node scripts/sanity/fix-seeded-pages.mjs --dry-run",
    "sanity:seed-images": "node scripts/sanity/seed-new-image-fields.mjs",
    "sanity:seed-images:dry": "node scripts/sanity/seed-new-image-fields.mjs --dry-run",
    "pages:check": "node scripts/sanity/check-pages.mjs",
    "sanity:menus": "node scripts/sanity/unify-menu-files.mjs",
    "sanity:menus:dry": "node scripts/sanity/unify-menu-files.mjs --dry-run",
    "sanity:spa-steps": "node scripts/sanity/split-treatment-steps.mjs",
    "sanity:spa-steps:dry": "node scripts/sanity/split-treatment-steps.mjs --dry-run"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.12.0",
    "next": "16.2.10",
    "next-sanity": "^13.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "^6.12.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
